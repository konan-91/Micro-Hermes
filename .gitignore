# --- Rust/Cargo ---
# Block the entire target directory where compilation happens
/target/

# Block Cargo's local lockfile adjustments or overrides if editing directly
# (Note: Keep Cargo.lock! It should be committed for applications/binaries)
**/*.rs.bk

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- Operating System Junk ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Environment Variables ---
# Keep your local secrets out of GitHub
.env
.env*.local

# --- Generated benchmark output ---
*.csv
results/
